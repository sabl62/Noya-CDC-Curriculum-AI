# =============================================================================
# BACKEND ENVIRONMENT VARIABLES (place in backend-main/.env)
# =============================================================================

# Django
SECRET_KEY=your_django_secret_key_here
# Generate a real key: python -c "import secrets; print(secrets.token_hex(32))"

# Database (leave empty to use SQLite for local dev)
# PostgreSQL format: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# Debug mode (set to true for development)
DEBUG=false

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# =============================================================================
# AI API KEYS (required for LLM functionality)
# =============================================================================

# Gemini (primary LLM provider)
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# DeepSeek (fallback LLM provider)
# Get your key: https://platform.deepseek.com
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_API_KEY_1=your_deepseek_api_key_1
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=
DEEPSEEK_API_KEY_4=
DEEPSEEK_API_KEY_5=

# Kira AI (backup LLM provider)
# Get your key: https://kiraai.vn
KIRAA_API_KEY_1=kira_your_kira_api_key_1
KIRAA_API_KEY_2=
KIRAA_API_KEY_3=
KIRAA_API_KEY_4=
KIRAA_API_KEY_5=

# Groq (title generation + question classification)
# Get your key: https://console.groq.com
GROQ_API_KEY_1=your_groq_api_key_1
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# =============================================================================
# VECTOR DATABASE (required for RAG functionality)
# =============================================================================

# Qdrant Cloud
# Get your cluster: https://cloud.qdrant.io
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# =============================================================================
# OPTIONAL
# =============================================================================

# Firebase Admin SDK (for Firestore - optional)
FIREBASE_CREDENTIALS_PATH=

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (place in frontend/.env)
# =============================================================================

VITE_API_URL=http://localhost:8000
