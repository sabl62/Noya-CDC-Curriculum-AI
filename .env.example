# .env file in backend-main/
SECRET_KEY=your_django_secret_key
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# AI APIs — Provider Rotation
# Gemini (primary): free plan → gemini-2.5-flash, paid plan → gemini-2.5-pro
# All Gemini keys tried first; if exhausted, falls back to DeepSeek below.
GEMINI_API_KEY_1=your_gemini_api_key_1


# DeepSeek (fallback): deepseek-v4-flash-free, used after all Gemini keys exhausted
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_API_KEY_1=your_deepseek_api_key_1


# .env file in frontend/
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
